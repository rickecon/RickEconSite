---
import { nav } from '../data/site';
const { pathname } = Astro.url;
// Normalize trailing slash for active-link comparison.
const current = pathname.replace(/\/+$/, '') || '/';
const norm = (href: string) => href.replace(/\/+$/, '') || '/';
function isActive(item: { href: string; section?: string[] }) {
  return [item.href, ...(item.section ?? [])].some((h) => norm(h) === current);
}
---
<nav class="nav" id="site-nav" aria-label="Primary">
  {nav.map((item) => (
    <a
      href={item.href}
      {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
      aria-current={!item.external && isActive(item) ? 'page' : undefined}
    >
      {item.label}
    </a>
  ))}
</nav>
