---
import { site } from '../data/site';
const year = 2026; // update yearly, or wire to a build-time date if preferred
---
<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <span>&copy; {year} {site.shortName}</span>
    <div class="footer-social">
      <a href={`mailto:${site.contact.email}`}>Email</a>
      <a href={site.contact.linkedin.url} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.contact.github.url} target="_blank" rel="noopener">GitHub</a>
      <a href={site.contact.x.url} target="_blank" rel="noopener">X</a>
      <a href={site.contact.substack.url} target="_blank" rel="noopener">Substack</a>
      <a href={site.cvPath} target="_blank" rel="noopener">CV</a>
    </div>
  </div>
</footer>
