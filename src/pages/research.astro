---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

type Entry = { data: { title: string; date: Date; authors?: string; venue?: string; note?: string; url?: string; featured?: boolean } };
const byDate = (a: Entry, b: Entry) => b.data.date.getTime() - a.data.date.getTime();

const publications = (await getCollection('publications')).sort(byDate);
const works = (await getCollection('worksInProgress')).sort(byDate);
const fmt = (d: Date) => d.getUTCFullYear();
---
<Base title="Research" description="Publications and works in progress by Richard W. Evans, PhD.">
  <header class="page-header">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">Scholarship</p>
      <h1>Research</h1>
      <p class="muted">
        A selection of recent publications and current projects. The
        <a href={site.cvPath} target="_blank" rel="noopener">full CV</a> lists all peer-reviewed
        articles, book chapters, reports, and grants.
      </p>
    </div>
  </header>

  <section class="wrap wrap-narrow section" id="works-in-progress">
    <h2>Works in Progress</h2>
    <ul class="ref-list">
      {works.map((it) => (
        <li>
          {it.data.url
            ? <a href={it.data.url} target="_blank" rel="noopener"><strong>{it.data.title}</strong></a>
            : <strong>{it.data.title}</strong>}
          <div class="item__meta">
            {[it.data.authors, it.data.venue].filter(Boolean).join(' · ')}
            {(it.data.authors || it.data.venue) ? ' · ' : ''}{fmt(it.data.date)}
          </div>
          {it.data.note && <span class="item__note">{it.data.note}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap wrap-narrow section" id="publications">
    <h2>Publications</h2>
    <ul class="ref-list">
      {publications.map((it) => (
        <li>
          {it.data.url
            ? <a href={it.data.url} target="_blank" rel="noopener"><strong>{it.data.title}</strong></a>
            : <strong>{it.data.title}</strong>}
          <div class="item__meta">
            {[it.data.authors, it.data.venue].filter(Boolean).join(' · ')}
            {(it.data.authors || it.data.venue) ? ' · ' : ''}{fmt(it.data.date)}
          </div>
          {it.data.note && <span class="item__note">{it.data.note}</span>}
        </li>
      ))}
    </ul>
    <p style="margin-top:2rem;">
      <a class="btn btn--ghost" href={site.cvPath} target="_blank" rel="noopener">Full publication list (CV)</a>
    </p>
  </section>
</Base>
