---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import headshot from '../assets/Evans_headshot.jpg';

// ── Load the three recent lists, newest first, top 4 (featured pinned) ──
type Entry = { data: { title: string; date: Date; authors?: string; venue?: string; note?: string; url?: string; featured?: boolean } };
function recent(items: Entry[], n = 4) {
  return [...items]
    .sort((a, b) => {
      if (!!b.data.featured !== !!a.data.featured) return a.data.featured ? -1 : 1;
      return b.data.date.getTime() - a.data.date.getTime();
    })
    .slice(0, n);
}
const publications = recent(await getCollection('publications'));
const works = recent(await getCollection('worksInProgress'));
const news = recent(await getCollection('news'));

const fmtYear = (d: Date) => d.getUTCFullYear();

// ── Light markdown for the quote fields: [label](url) links and *italics* ──
// Everything is HTML-escaped first, then only those two patterns become markup,
// so the fields stay safe to edit as plain text in src/data/site.ts.
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const emphasize = (s: string) => s.replace(/\*([^*]+)\*/g, '<em>$1</em>');

function richText(value: string) {
  // One pass over both patterns, so a URL is never rescanned for asterisks.
  return escapeHtml(value).replace(
    /\[([^\]]+)\]\(([^)\s]+)\)|\*([^*]+)\*/g,
    (whole, label, url, italic) => {
      if (italic !== undefined) return `<em>${italic}</em>`;
      const external = /^(https?:|mailto:)/i.test(url);
      // Allow absolute links, mail links, and site-relative paths; leave anything
      // else (e.g. a stray "javascript:") as the literal text that was typed.
      if (!external && !/^[/#]/.test(url)) return whole;
      const attrs = external ? ' target="_blank" rel="noopener"' : '';
      // Link labels may themselves contain *italics*.
      return `<a href="${url}"${attrs}>${emphasize(label)}</a>`;
    },
  );
}

const columns = [
  { heading: 'Recent Publications', items: publications, more: '/research/#publications' },
  { heading: 'Works in Progress', items: works, more: '/research/#works-in-progress' },
  { heading: 'Other Links & News', items: news, more: '/links/' },
];
---
<Base>
  <!-- Hero: (i) headshot + CV, (ii) name + specializations, (iii) contact -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__left">
        <Image src={headshot} alt="Portrait of Richard W. Evans" class="hero__photo" width={336} height={336} densities={[1, 2]} loading="eager" />
        <a class="btn btn--primary hero__cv" href={site.cvPath} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          View CV
        </a>
      </div>

      <div class="hero__intro">
        <h1 class="hero__name">{site.name}</h1>
        <div class="hero__positions">
          <p>Senior Economist, <a href="https://abundance.institute/" target="_blank" rel="noopener">Abundance Institute</a></p>
          <p>Director and Founder, <a href="https://www.oselab.org/" target="_blank" rel="noopener">Open Source Economics Laboratory (OSE Lab)</a></p>
        </div>
        <p class="hero__spec">{site.tagline}</p>
      </div>

      <div class="card hero__contact">
        <h3>Contact</h3>
        <ul class="contact-list">
          <li><span class="k">Email</span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li><span class="k">LinkedIn</span><a href={site.contact.linkedin.url} target="_blank" rel="noopener">{site.contact.linkedin.handle}</a></li>
          <li><span class="k">GitHub</span><a href={site.contact.github.url} target="_blank" rel="noopener">@{site.contact.github.handle}</a></li>
          <li><span class="k">X</span><a href={site.contact.x.url} target="_blank" rel="noopener">{site.contact.x.handle}</a></li>
          <li><span class="k">Substack</span><a href={site.contact.substack.url} target="_blank" rel="noopener">{site.contact.substack.handle}</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Info grid: positions / contact / fields / education -->
  <section class="wrap">
    <!-- Favorite quotes (between the top section and the recent-item lists).
         Every quote is rendered; the script below reveals one at a time. Without
         JavaScript the first one stays visible. -->
    <figure class="quote" id="quote-rotator" data-interval={site.quoteIntervalMs}>
      <div class="quote__stack">
        {site.quotes.map((q, i) => (
          <div class:list={['quote__item', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
            <blockquote>&ldquo;<Fragment set:html={richText(q.text)} />&rdquo;</blockquote>
            <cite>&mdash; <Fragment set:html={richText(q.author)} />{q.source ? ', ' : ''}<Fragment set:html={q.source ? richText(q.source) : ''} /></cite>
          </div>
        ))}
      </div>

      {site.quotes.length > 1 && (
        <figcaption class="quote__nav">
          <button type="button" class="quote__btn" data-quote-prev aria-label="Previous quote">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button" class="quote__btn" data-quote-next aria-label="Next quote">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <!-- Position indicator. The total is however many quotes are in
               src/data/quotes.md, so it updates itself when one is added. -->
          <p class="quote__count" aria-live="polite">
            <span data-quote-index>1</span> / <span data-quote-total>{site.quotes.length}</span>
          </p>
        </figcaption>
      )}
    </figure>
  </section>

  <!-- Three recent lists -->
  <section class="wrap section">
    <div class="recent">
      {columns.map((col) => (
        <div class="card recent__col">
          <h2>{col.heading}</h2>
          <ul class="items">
            {col.items.map((it) => (
              <li>
                {it.data.url
                  ? <a class="item__title" href={it.data.url} target="_blank" rel="noopener">{it.data.title}</a>
                  : <span class="item__title">{it.data.title}</span>}
                <div class="item__meta">
                  {[it.data.authors, it.data.venue].filter(Boolean).join(' · ')}
                  {(it.data.authors || it.data.venue) ? ' · ' : ''}{fmtYear(it.data.date)}
                </div>
                {it.data.note && <span class="item__note">{it.data.note}</span>}
              </li>
            ))}
          </ul>
          <a class="recent__more" href={col.more}>See all &rarr;</a>
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  // Cycle the favorite quotes in order, looping back to the first, and let the
  // back/forward buttons step through them by hand. The quotes come from
  // src/data/quotes.md and the interval from src/data/site.ts — nothing to edit
  // here.
  const rotator = document.getElementById('quote-rotator');
  const items = rotator ? Array.from(rotator.querySelectorAll('.quote__item')) : [];

  if (rotator && items.length > 1) {
    const interval = Number(rotator.dataset.interval) || 12000;
    const indexLabel = rotator.querySelector('[data-quote-index]');
    let shown = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function show(next: number) {
      items[shown].classList.remove('is-active');
      items[shown].setAttribute('aria-hidden', 'true');
      // Wrap in both directions, so back from the first lands on the last.
      shown = (next + items.length) % items.length;
      items[shown].classList.add('is-active');
      items[shown].removeAttribute('aria-hidden');
      if (indexLabel) indexLabel.textContent = String(shown + 1);
    }

    const start = () => { timer ??= setInterval(() => show(shown + 1), interval); };
    const stop = () => { clearInterval(timer); timer = undefined; };
    // A click restarts the countdown, so the quote you chose gets a full turn.
    const step = (by: number) => { stop(); show(shown + by); if (!document.hidden) start(); };

    rotator.querySelector('[data-quote-prev]')?.addEventListener('click', () => step(-1));
    rotator.querySelector('[data-quote-next]')?.addEventListener('click', () => step(1));

    start();
    // Don't run the timer while the tab is in the background, so returning to the
    // page gives you a fresh full interval rather than a quote mid-swap.
    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : start();
    });
  }
</script>
